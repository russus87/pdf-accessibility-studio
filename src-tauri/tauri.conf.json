{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Accessibility Studio",
  "version": "0.5.1",
  "identifier": "com.pdfa11ystudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Accessibility Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["pdfium/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/russus87/pdf-accessibility-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQTRBMjc3RUVDNTVCQjAKUldTd1c4WHVkNktrTThwaXc0R2I5MXFUWFFIQkgrVE1BQnV1c0ZKekRnWFJHTnFGY0dOYkNjdngK"
    }
  }
}
