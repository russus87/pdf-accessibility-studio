# PKGBUILD per PDF Accessibility Studio — genera un pacchetto Arch .pkg.tar.zst.
# Pensato per la CI: la versione viene iniettata da release.yml (sed su pkgver).
pkgname=pdf-accessibility-studio
pkgver=0.1.0
pkgrel=1
pkgdesc="Visore e validatore di PDF accessibili (Rust + Tauri + Svelte)"
arch=('x86_64')
url="https://github.com/russus87/pdf-accessibility-studio"
license=('MIT')
# A runtime: webkit per la finestra Tauri, gtk3 per la UI nativa.
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'base-devel' 'curl')
options=('!strip' '!lto')

# Il PKGBUILD sta in packaging/, quindi la root del repo e' la cartella superiore.
_repo() { echo "$startdir/.."; }

build() {
    cd "$(_repo)"
    npm install
    # Scarica la libreria nativa Pdfium (verra' installata in /usr/lib).
    bash scripts/fetch-pdfium.sh packaging/pdfium
    # Build con la CLI di Tauri (modalita' produzione, frontend incorporato).
    # --no-bundle: niente installer, il pacchetto lo fa makepkg.
    npm run tauri build -- --no-bundle
}

package() {
    cd "$(_repo)"
    install -Dm755 "target/release/pdf-accessibility-studio" \
        "$pkgdir/usr/bin/pdf-accessibility-studio"
    # Libreria Pdfium tra le librerie di sistema: l'app la trova da li'.
    install -Dm755 packaging/pdfium/libpdfium.so "$pkgdir/usr/lib/libpdfium.so"
    install -Dm644 "packaging/pdf-accessibility-studio.desktop" \
        "$pkgdir/usr/share/applications/pdf-accessibility-studio.desktop"
    install -Dm644 "src-tauri/icons/128x128.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/pdf-accessibility-studio.png"
    install -Dm644 "src-tauri/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/pdf-accessibility-studio.png"
}
